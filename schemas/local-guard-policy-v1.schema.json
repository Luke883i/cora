{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CORA PR06 local guard policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "baseline_commit",
    "products",
    "exceptions"
  ],
  "properties": {
    "schema": {
      "const": "cora-local-guard/1"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "module_prefix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "module_prefix": {
            "type": "string"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 0
    }
  },
  "description": "The independent guard CI check must be required/protected; the local policy is otherwise self-editable."
}
