{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CORA scoped observational closure certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim",
    "commit",
    "path",
    "selector",
    "ledger_digest",
    "sources",
    "obligations",
    "status",
    "blocking",
    "effect",
    "caveat",
    "certificate_digest"
  ],
  "properties": {
    "schema": {
      "const": "cora-closure-certificate/1"
    },
    "claim": {
      "enum": [
        "committed_blob",
        "declared_product_membership",
        "declared_manifest_dependency",
        "static_import_candidate",
        "safe_deletion"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "selector": {
      "type": "string"
    },
    "ledger_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "VERIFIED",
              "COUNTEREXAMPLE",
              "UNKNOWN",
              "UNSUPPORTED"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "PASS_SCOPED",
        "BLOCKED",
        "REFUTED"
      ]
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect": {
      "const": "OBSERVATIONAL_ONLY"
    },
    "caveat": {
      "type": "string"
    },
    "certificate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Companion schema only; authoritative validation reconstructs evidence from Git objects."
}
